<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShiftCraft.Mobile.ViewModels"
             xmlns:models="clr-namespace:ShiftCraft.Mobile.Models"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             x:Class="ShiftCraft.Mobile.Views.TimeOffPage"
             x:DataType="vm:TimeOffViewModel"
             Title="İzin Talepleri"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" 
                       Text="İzin Talepleri"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"/>
                <Button Grid.Column="1"
                        Text="+ Yeni Talep"
                        Command="{Binding ToggleFormCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontSize="13"
                        HeightRequest="36"
                        CornerRadius="8"/>
            </Grid>

            <!-- Create Form -->
            <Frame BackgroundColor="White" 
                   Padding="15" 
                   CornerRadius="10" 
                   HasShadow="True"
                   IsVisible="{Binding ShowForm}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Yeni İzin Talebi" FontSize="18" FontAttributes="Bold"/>

                    <Label Text="Başlangıç Tarihi" FontSize="14" TextColor="{StaticResource Gray600}"/>
                    <DatePicker Date="{Binding StartDate}" 
                                MinimumDate="{x:Static sys:DateTime.Today}" 
                                Format="dd MMMM yyyy"/>

                    <Label Text="Bitiş Tarihi" FontSize="14" TextColor="{StaticResource Gray600}"/>
                    <DatePicker Date="{Binding EndDate}" 
                                MinimumDate="{x:Static sys:DateTime.Today}" 
                                Format="dd MMMM yyyy"/>

                    <Label Text="İzin Türü" FontSize="14" TextColor="{StaticResource Gray600}"/>
                    <Picker ItemsSource="{Binding LeaveTypes}" 
                            SelectedItem="{Binding SelectedType}"
                            Title="İzin türü seçin"/>

                    <Label Text="Açıklama" FontSize="14" TextColor="{StaticResource Gray600}"/>
                    <Editor Text="{Binding Reason}" 
                            Placeholder="İzin sebebinizi yazın..."
                            HeightRequest="80"/>

                    <Frame BackgroundColor="#FFEBEE" 
                           BorderColor="#EF5350"
                           Padding="15" 
                           CornerRadius="8"
                           IsVisible="{Binding HasError}">
                        <Label Text="{Binding ErrorMessage}" TextColor="#C62828"/>
                    </Frame>

                    <Button Text="Talep Oluştur"
                            Command="{Binding CreateCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontSize="16"
                            HeightRequest="44"
                            CornerRadius="10"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Requests List -->
            <CollectionView ItemsSource="{Binding TimeOffRequests}"
                            EmptyView="İzin talebi bulunmuyor">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TimeOffRequestModel">
                        <Frame BackgroundColor="White" 
                               Padding="15" 
                               CornerRadius="10" 
                               HasShadow="True" 
                               Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding EmployeeName}" 
                                               FontSize="16" 
                                               FontAttributes="Bold"/>
                                        <Label Text="{Binding TypeText}" 
                                               FontSize="13" 
                                               TextColor="{StaticResource Gray600}"/>
                                    </VerticalStackLayout>
                                    <Frame Grid.Column="1" 
                                           BackgroundColor="#FFF3E0" 
                                           CornerRadius="12" 
                                           Padding="8,4" 
                                           HasShadow="False">
                                        <Label Text="{Binding StatusText}" 
                                               FontSize="12" 
                                               TextColor="#E65100"/>
                                    </Frame>
                                </Grid>

                                <Label Text="{Binding DateRangeText}" 
                                       FontSize="14" 
                                       TextColor="{StaticResource Primary}"/>

                                <Label Text="{Binding Reason}" 
                                       FontSize="13" 
                                       TextColor="{StaticResource Gray600}"
                                       IsVisible="{Binding Reason, Converter={StaticResource NullToBoolConverter}}"/>

                                <Label Text="{Binding CreatedAtText}" 
                                       FontSize="12" 
                                       TextColor="{StaticResource Gray400}"/>

                                <!-- Manager Actions for Pending -->
                                <HorizontalStackLayout Spacing="10" 
                                                       HorizontalOptions="End"
                                                       Margin="0,5,0,0">
                                    <Button Text="Onayla"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TimeOffViewModel}}, Path=ApproveCommand}"
                                            CommandParameter="{Binding Id}"
                                            BackgroundColor="#4CAF50"
                                            TextColor="White"
                                            FontSize="13"
                                            HeightRequest="36"
                                            CornerRadius="8"/>
                                    <Button Text="Reddet"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TimeOffViewModel}}, Path=RejectCommand}"
                                            CommandParameter="{Binding Id}"
                                            BackgroundColor="#F44336"
                                            TextColor="White"
                                            FontSize="13"
                                            HeightRequest="36"
                                            CornerRadius="8"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HeightRequest="40"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
