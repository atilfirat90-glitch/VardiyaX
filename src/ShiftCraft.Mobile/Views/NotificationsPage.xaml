<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShiftCraft.Mobile.ViewModels"
             x:Class="ShiftCraft.Mobile.Views.NotificationsPage"
             x:DataType="vm:NotificationsViewModel"
             Title="Bildirimler"
             BackgroundColor="{StaticResource Gray100}">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" Padding="0,0,10,0">
            <Label Text="Bildirimler" 
                   FontSize="18" 
                   FontAttributes="Bold" 
                   TextColor="White"
                   VerticalOptions="Center"/>
            <Button Grid.Column="1" 
                    Text="Tümünü Oku"
                    Command="{Binding MarkAllReadCommand}"
                    IsVisible="{Binding HasUnread}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="12"
                    Padding="8,4"/>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,*">
        <!-- Unread Badge -->
        <Frame Grid.Row="0"
               IsVisible="{Binding HasUnread}"
               BackgroundColor="#E3F2FD"
               CornerRadius="0"
               Padding="15,10"
               HasShadow="False">
            <Label TextColor="#1565C0" FontSize="13">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="🔔 " FontSize="14"/>
                        <Span Text="{Binding UnreadCount, StringFormat='{0} okunmamış bildirim'}" 
                              FontAttributes="Bold"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </Frame>

        <!-- Error Message -->
        <Frame Grid.Row="0"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
               BackgroundColor="#FFEBEE"
               CornerRadius="0"
               Padding="15,10"
               HasShadow="False">
            <Label Text="{Binding ErrorMessage}" TextColor="#C62828" FontSize="13"/>
        </Frame>

        <!-- Notification List -->
        <RefreshView Grid.Row="1"
                     Command="{Binding RefreshCommand}"
                     IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Notifications}"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" 
                                         HorizontalOptions="Center"
                                         Padding="40"
                                         Spacing="10">
                        <Label Text="🔕" FontSize="48" HorizontalOptions="Center"/>
                        <Label Text="Henüz bildirim yok" 
                               FontSize="16" 
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray500}"
                               HorizontalOptions="Center"/>
                        <Label Text="Vardiya güncellemeleri ve hatırlatmalar burada görünecek" 
                               FontSize="13" 
                               TextColor="{StaticResource Gray400}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Frame Margin="10,5" 
                               Padding="15" 
                               CornerRadius="10"
                               HasShadow="False">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=NotificationTappedCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Frame.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0" 
                                       FontSize="24" 
                                       VerticalOptions="Start"
                                       Margin="0,2,0,0"/>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label FontSize="14" 
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"/>
                                    <Label FontSize="12" 
                                           TextColor="{StaticResource Gray600}"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation"/>
                                    <Label FontSize="11" 
                                           TextColor="{StaticResource Gray400}"/>
                                </VerticalStackLayout>
                                <BoxView Grid.Column="2"
                                         WidthRequest="8" 
                                         HeightRequest="8"
                                         CornerRadius="4"
                                         Color="{StaticResource Primary}"
                                         VerticalOptions="Start"
                                         Margin="0,6,0,0"/>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!-- Loading -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Primary}"
                           VerticalOptions="Center"/>
    </Grid>
</ContentPage>
