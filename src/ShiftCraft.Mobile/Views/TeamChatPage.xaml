<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ShiftCraft.Mobile.ViewModels"
             xmlns:models="clr-namespace:ShiftCraft.Mobile.Models"
             x:Class="ShiftCraft.Mobile.Views.TeamChatPage"
             x:DataType="vm:TeamChatViewModel"
             Title="Takım Sohbeti"
             BackgroundColor="{StaticResource Gray100}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Channel Selector -->
        <Frame Grid.Row="0" BackgroundColor="White" Padding="10,5" HasShadow="True" CornerRadius="0">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label Text="Kanal:" VerticalOptions="Center" FontSize="14"/>
                <Picker ItemsSource="{Binding Channels}"
                        SelectedItem="{Binding SelectedChannel}"
                        FontSize="14"
                        WidthRequest="150"/>
            </HorizontalStackLayout>
        </Frame>

        <!-- Messages -->
        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Messages}"
                        EmptyView="Henüz mesaj yok. İlk mesajı siz gönderin!"
                        Margin="10,10,10,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TeamMessageModel">
                    <Frame BackgroundColor="White" 
                           Padding="12" 
                           CornerRadius="10" 
                           HasShadow="True" 
                           Margin="0,0,0,8">
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" 
                                       Text="{Binding SenderName}" 
                                       FontSize="14" 
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"/>
                                <Label Grid.Column="1" 
                                       Text="{Binding CreatedAtText}" 
                                       FontSize="11" 
                                       TextColor="{StaticResource Gray400}"/>
                            </Grid>
                            <Label Text="{Binding Content}" 
                                   FontSize="15" 
                                   TextColor="{StaticResource Gray900}"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Message Input -->
        <Frame Grid.Row="2" BackgroundColor="White" Padding="10" HasShadow="True" CornerRadius="0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Entry Grid.Column="0" 
                       Text="{Binding NewMessage}" 
                       Placeholder="Mesaj yazın..."
                       FontSize="15"
                       ReturnCommand="{Binding SendCommand}"/>
                <Button Grid.Column="1"
                        Text="Gönder"
                        Command="{Binding SendCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontSize="14"
                        HeightRequest="40"
                        CornerRadius="8"/>
            </Grid>
        </Frame>

        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsBusy}" 
                           IsVisible="{Binding IsBusy}"
                           Color="{StaticResource Primary}"
                           VerticalOptions="Center"/>
    </Grid>
</ContentPage>
